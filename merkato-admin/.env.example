# MerkatoLink Admin Portal Configuration
# Backend API root URL (no trailing slash, no /api)
# For local development: http://localhost:5001
# For production: https://merkato-link.onrender.com
VITE_API_URL=https://merkato-link.onrender.com

# Authentication settings
VITE_JWT_SECRET=your-jwt-secret-key-here

# Admin credentials (for initial setup)
VITE_ADMIN_EMAIL=admin@merkato.link
VITE_ADMIN_PASSWORD=admin123

# Application settings
VITE_APP_NAME=MerkatoLink Admin
VITE_APP_VERSION=1.0.0